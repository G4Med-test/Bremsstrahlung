#
# macro file for bremsstrahlung
#
/control/verbose 0
/run/verbose 0

#
# define here the Scattering foil
#
/testem/det/setMaterial theMaterial 
/testem/det/setThickness theThickness cm
/testem/det/setRadius theRadius cm
/testem/det/setParameterA theParameterA cm
/testem/det/setParameterB theParameterB cm
/testem/det/setParameterC theParameterC cm
/testem/det/setParameterD theParameterD cm
/testem/det/setParameterE theParameterE cm
/testem/det/setParameterF theParameterF cm

/testem/phys/addPhysics theEmModel 

/run/initialize
#/testem/stepMax 5 cm # From Ross, et. al. Med. Phys. 35
/run/setCut 0.05 mm 
/process/em/setSecBiasing eBrem split 100 theEnergy MeV

/gun/particle e- 
/gun/energy theEnergy MeV

/analysis/setFileName results/theMaterial_theEmModel_theEKin_MeV
/analysis/h1/set 0 100   0.1   40 MeV none log
/analysis/h1/set 1 100   0.1   40 MeV none log
/analysis/h1/set 2 100   0.1   40 MeV none log
/analysis/h1/set 3 100   0.1   40 MeV none log
/analysis/h1/set 4 100   0.1   40 MeV none log
/analysis/h1/set 5 100   0.1   40 MeV none log
/analysis/h1/set 6 100   0.1   40 MeV none log
/analysis/h1/set 7 100   0.1   40 MeV none log

/run/printProgress 200000 
/run/beamOn        2000000 

